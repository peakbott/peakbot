# Copy this file to .env and fill in real values. Never commit .env.

# --- Website: Lovable Cloud / database ---
SUPABASE_URL=https://REPLACE_ME.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME
VITE_SUPABASE_URL=https://REPLACE_ME.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# --- Website: security ---
# Long random string, e.g. run: openssl rand -hex 32
SESSION_SECRET=REPLACE_ME
# Password for the hidden admin panel (tap the PEAK logo 5 times)
ADMIN_PASSWORD=REPLACE_ME

# --- Optional: public site address (used for Discord OAuth redirect) ---
SITE_URL=https://your-site.onrender.com
